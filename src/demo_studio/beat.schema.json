{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happymonkey.ai/demo-studio/beat.schema.json",
  "title": "demo-studio beat file",
  "type": "object",
  "required": ["version", "product", "beats"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "base_url_env": {
      "type": "string",
      "default": "DEMO_BASE_URL",
      "description": "Env var holding the subject site base URL"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320, "default": 1920 },
        "height": { "type": "integer", "minimum": 240, "default": 1080 },
        "fps": { "type": "integer", "minimum": 1, "default": 30 }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "required": ["id", "narration"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "narration": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "default": []
        },
        "assert": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" },
          "default": []
        },
        "pause_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Hold after actions before next beat (capture pacing)"
        },
        "min_narration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Pad video/audio so narration is not cut short"
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "wait_text",
            "wait_ms",
            "click_text",
            "fill",
            "press",
            "screenshot",
            "wait_url_not",
            "snapshot",
            "note"
          ]
        },
        "url": { "type": "string" },
        "text": { "type": "string" },
        "value": { "type": "string" },
        "ms": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "description": "Path relative to base URL" },
        "selector": { "type": "string" },
        "label": { "type": "string" },
        "exact": { "type": "boolean" },
        "env": {
          "type": "string",
          "description": "Read fill value from environment (e.g. ADMIN_PASSWORD from .local/*.env)"
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["url_contains", "page_has_text", "http_ok"]
        },
        "value": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
